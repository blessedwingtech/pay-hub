# BitTonik Pay-Hub - Environment Configuration

# Database (PostgreSQL via Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/payhub?schema=public"

# App & Domain Settings
NEXT_PUBLIC_APP_URL="https://pay.bittonik.com"
PORT=3000

# Webhook Security - HMAC-SHA256 signature between Pay-Hub and Satellite Apps
# All satellites (MemoTonik, ShopTonik, Academy, BWT, PressTonik) share this secret
PAY_HUB_WEBHOOK_SECRET="super_secret_pay_hub_hmac_signing_key_change_in_production"

# Master Admin Security Key for /recurring management dashboard & API
PAYHUB_ADMIN_KEY="ChangeMeSecureAdminPassword2026!"

# Stripe Gateway (Pay-In & Billing & Connect)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal Gateway (Pay-In & Payouts API)
PAYPAL_CLIENT_ID="paypal_client_id_..."
PAYPAL_CLIENT_SECRET="paypal_client_secret_..."
PAYPAL_WEBHOOK_ID="paypal_webhook_id_..."
PAYPAL_ENVIRONMENT="sandbox" # sandbox or production

# MonCash Gateway (Haiti Mobile Money HTG - Digicel)
MONCASH_CLIENT_ID="moncash_client_id_..."
MONCASH_CLIENT_SECRET="moncash_client_secret_..."
MONCASH_MODE="sandbox" # sandbox or production

# Bazik Gateway (Haiti MonCash & Mobile Money API - https://bazik.io)
BAZIK_USER_ID="bzk_5ae8380e_1794545677"
BAZIK_SECRET_KEY="sk_61791d175960c6ae958b131b6f3c111e"
BAZIK_WEBHOOK_SECRET="whsec_ee0e56e50bfdc39c2eaae93ed44c5ce8"
BAZIK_BASE_URL="https://api.bazik.io"

# Satellite Webhook Endpoints (Configured destinations for outbound notifications)
MEMOTONIK_WEBHOOK_URL="https://memotonik.bittonik.com/api/webhooks/pay-hub"
SHOPTONIK_WEBHOOK_URL="https://shop.bittonik.com/api/webhooks/pay-hub"
ACADEMY_WEBHOOK_URL="https://academy.bittonik.com/api/webhooks/pay-hub"
BWT_WEBHOOK_URL="https://bwt.bittonik.com/api/webhooks/pay-hub"
PRESSTONIK_WEBHOOK_URL="https://press.bittonik.com/api/webhooks/pay-hub"
